{
  "permissions": {
    "allow": [
      "Bash(python -c ' *)",
      "Bash(python main.py Naver Upstage Anthropic OpenAI)",
      "Bash(python -m pytest *)",
      "PowerShell(python -c \"import json,sys; json.load\\(sys.stdin\\); print\\('JSON OK'\\)\")",
      "WebFetch(domain:api.ashbyhq.com)",
      "Bash(python main.py Toss)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/run_tests.py",
            "timeout": 120,
            "statusMessage": "테스트 실행 중..."
          }
        ]
      }
    ]
  }
}
